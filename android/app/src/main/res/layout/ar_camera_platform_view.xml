<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.dubai.bimobondapp.ar_camera.FaceWarpGlView
        android:id="@+id/warpGlView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.dubai.bimobondapp.ar_camera.FaceOverlayView
        android:id="@+id/faceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!--
      Screen-overlay filter animation — pure decoration on top of the live
      preview, shared by Confetti/Keywords/Snowfall/Snow White (only
      one is ever active at a time; ArCameraBridge.applyRenderMode swaps which
      asset is loaded based on the selected filter). Transparent background
      so the camera stays visible underneath; not clickable/focusable so it
      never intercepts touches meant for camera controls below it. No static
      lottie_fileName/autoPlay here — asset + playback are entirely driven
      from Kotlin (ArCameraPlatformView.init, ArCameraBridge.applyRenderMode)
      since which animation plays depends on the selected filter.
      scaleType="centerCrop": several of these compositions aren't the same
      aspect ratio as the phone screen (e.g. Confetti/Matrix are square) — the
      ImageView default (fitCenter) would shrink them to fit width, leaving
      the animation as a centered box with empty space above/below instead of
      covering the full screen top-to-bottom. centerCrop fills the view and
      crops any overflow instead.
    -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/confettiOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:lottie_loop="true" />

</FrameLayout>
